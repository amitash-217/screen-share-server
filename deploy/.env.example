POSTGRES_PASSWORD=change-me
TURN_SECRET=change-me-too
# What clients connect to and what TURN advertises: this server's domain name or IP address.
PUBLIC_HOST=203.0.113.10
# This server's public IP address (coturn needs the address itself, not a domain).
PUBLIC_IP=203.0.113.10
# Set to false to close signup; then create accounts with the create-user command (see README).
SIGNUP_ENABLED=true

# HTTPS with a domain name (docker compose --profile tls up -d):
#   SERVER_BIND=127.0.0.1
#   TRUST_PROXY=true
SERVER_BIND=0.0.0.0
TRUST_PROXY=false
